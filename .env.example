# Public Supabase project configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# XR CRM server-only secrets — never prefix these with VITE_
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
XR_CRM_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
XR_CRM_ADMIN_PASS=UNIQUE_ADMIN_PASSWORD_MINIMUM_12_CHARACTERS
XR_CRM_STAFF_PASS=TEMPORARY_TEAM_PASSWORD_MINIMUM_12_CHARACTERS

# Optional bank-transfer details. Leave unset until the contracting entity and bank account are verified.
XR_BANK_BENEFICIARY=
XR_BANK_NAME=
XR_BANK_IBAN=
XR_BANK_BIC=


